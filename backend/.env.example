# ============================================================================
# ARAI SYSTEM ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to: backend/.env
# Fill in all required values marked with [REQUIRED]
# ============================================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
DEBUG=True
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ============================================================================
# SUPABASE CONFIGURATION [REQUIRED]
# ============================================================================
# Get these from your Supabase project settings
# https://app.supabase.com/project/{project-id}/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ============================================================================
# FIGMA OAUTH 2.0 CONFIGURATION [REQUIRED]
# ============================================================================
# Get these from figma.com/developers
# Create a new app if you don't have one yet

# Your Figma OAuth App Credentials (Provided)
FIGMA_CLIENT_ID=0zUuRy2IrZ4IeA98hRRhF8
FIGMA_CLIENT_SECRET=gCva505ietO1MLe0JpJfj4V2Owwz6n

# Redirect URI where Figma sends authorization code back
# Must match exactly in Figma app settings
# For local development:
FIGMA_REDIRECT_URI=http://localhost:8000/api/v1/figma/auth/callback

# For production (update with your actual domain):
# FIGMA_REDIRECT_URI=https://your-backend-url.com/api/v1/figma/auth/callback

# Session secret for storing OAuth tokens (generate a random string)
SESSION_SECRET_KEY=change-this-to-a-random-string-in-production-123456

# ============================================================================
# JWT/AUTHENTICATION
# ============================================================================
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png

# ============================================================================
# AI MODEL PATHS
# ============================================================================
SALIENCY_MODEL_PATH=ai_models/saliency_model.pth
SALICON_MODEL_PATH=./ai_models/salicon_model
RICO_MODEL_PATH=./ai_models/rico_model

# ============================================================================
# CORS CONFIGURATION (OPTIONAL)
# ============================================================================
# Comma-separated list of additional allowed origins
# ALLOWED_ORIGINS=https://example.com,https://app.example.com

# ============================================================================
# EMAIL CONFIGURATION (for collaboration invitations)
# ============================================================================
# Option A: SendGrid (recommended for production)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FROM_EMAIL=noreply@yourdomain.com

# Option B: SMTP (e.g. Gmail, Mailgun SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password

# Frontend URL (used in invitation email links)
FRONTEND_URL=http://localhost:5173

# ============================================================================
# NOTES FOR DEPLOYMENT
# ============================================================================
# Railway/Render:
#   1. Set these variables in the platform's environment settings
#   2. Update FIGMA_REDIRECT_URI to your deployed backend URL
#   3. Update Figma app settings with new redirect URI
#
# Important:
#   - Never commit this file to git (add to .gitignore)
#   - Keep FIGMA_CLIENT_SECRET private
#   - Generate a secure SESSION_SECRET_KEY for production
#   - Use HTTPS in production (FIGMA_REDIRECT_URI must be https://)
